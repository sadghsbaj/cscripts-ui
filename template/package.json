{
    "name": "template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "bunx --bun vite",
        "build": "bunx --bun vite build",
        "preview": "bunx --bun vite preview",
        "check": "bunx --bun svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
        "test": "bunx vitest run",
        "test:watch": "bunx vitest",
        "test:e2e": "bunx --bun playwright test",
        "format": "bunx prettier --write .",
        "lint": "bunx --bun eslint .",
        "sync:agents": "cs-sync-agents",
        "postinstall": "bun run sync:agents"
    },
    "engines": {
        "npm": "DO_NOT_USE_NPM_USE_BUN",
        "pnpm": "DO_NOT_USE_PNPM_USE_BUN"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "latest",
        "@playwright/test": "latest",
        "@sveltejs/vite-plugin-svelte": "latest",
        "@tsconfig/svelte": "latest",
        "@types/node": "latest",
        "eslint": "latest",
        "happy-dom": "latest",
        "lightningcss": "latest",
        "prettier": "latest",
        "prettier-plugin-css-order": "latest",
        "prettier-plugin-svelte": "latest",
        "svelte": "latest",
        "svelte-check": "latest",
        "terser": "latest",
        "typescript": "~6.0.2",
        "unocss": "latest",
        "vite": "latest",
        "vite-plugin-html": "latest",
        "vitest": "latest"
    },
    "dependencies": {
        "cs": "github:sadghsbaj/cscripts-ui"
    }
}
