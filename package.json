{
    "name": "cs",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "format": "bunx prettier --write .",
        "lint": "eslint ."
    },
    "exports": {
        "./vite": "./src/vite/index.ts",
        "./css": "./src/css/index.css",
        "./css/*": "./src/css/components/*.css",
        "./uno": "./src/uno/index.ts",
        "./svelte": {
            "svelte": "./src/svelte/index.ts",
            "default": "./src/svelte/index.ts"
        },
        "./svelte/components": {
            "svelte": "./src/svelte/components/index.ts",
            "default": "./src/svelte/components/index.ts"
        },
        "./eslint": "./src/eslint/index.ts"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tsconfig/svelte": "^5.0.8",
        "@types/bun": "latest",
        "@types/node": "^24.13.2",
        "eslint": "^10.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-css-order": "^2.2.0",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.2",
        "typescript": "~6.0.2",
        "unocss": "^66.11.0",
        "vite": "^8.3.5"
    },
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "@lucide/svelte": "^1.61.0",
        "@unocss/eslint-config": "^66.11.0",
        "@unocss/extractor-svelte": "^66.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.20.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "globals": "^17.7.0",
        "typescript-eslint": "^8.63.0"
    },
    "peerDependencies": {
        "eslint": ">=10"
    },
    "peerDependenciesMeta": {
        "eslint": {
            "optional": true
        }
    },
    "engines": {
        "npm": "DO_NOT_USE_NPM_USE_BUN",
        "pnpm": "DO_NOT_USE_PNPM_USE_BUN"
    }
}
